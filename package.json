{
  "name": "dynexus-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "secrets": "secretlint --maskSecrets \"**/*\"",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^1.15.0",
    "@aptos-labs/wallet-adapter-react": "^5.0.1",
    "@heroicons/react": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.6",
    "next": "14.2.30",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@secretlint/secretlint-rule-pattern": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "lefthook": "2.2.2",
    "postcss": "^8",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
