{
  "name": "dynexus-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "secrets": "secretlint --maskSecrets \"**/*\"",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "5.2.1",
    "@aptos-labs/wallet-adapter-react": "8.3.3",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "5.104.5",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.2.2",
    "postcss": "^8",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
