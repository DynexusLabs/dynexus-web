# Copy to .env.local. NEXT_PUBLIC_* values are shipped to the browser — never put secrets here.
NEXT_PUBLIC_APTOS_NETWORK=testnet
# Public origin used for canonical URLs, Open Graph, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://dynexus.netlify.app
# Optional Aptos Build (geomi.dev) API key for higher rate limits
NEXT_PUBLIC_APTOS_API_KEY=
# Account that published DynexusForge, DynexusSwap and DynexusCore
NEXT_PUBLIC_DYNEXUS_ADDRESS=0x6e9d623d8aa35cf0453f96e2590d782bd19181e3f63758da443003b6049c44f6
# dynexus-indexer API; leave empty to read directly from chain view functions
NEXT_PUBLIC_INDEXER_URL=http://localhost:8080
